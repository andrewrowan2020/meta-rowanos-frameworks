From: RowanOS runtime integration
Subject: [PATCH] D16: acquire mapped KMS through the seat before Mali instance

Mali r48 opens card0 from vkCreateInstance and can become DRM master before
libseat takes the device. For an explicit D16 opt-in, acquire the verified
mediatek primary through the seat first. Retain normal nested initialization
and verify Vulkan later resolves to that same primary. No vendor features
are synthesized.

Upstream-Status: Inappropriate [D16 vendor ICD integration]

--- a/src/main.cpp
+++ b/src/main.cpp
@@ -746,7 +746,20 @@
 		}
 	}
 
+	// The D16 vendor ICD opens the primary node while creating its instance.
+	// Acquire that KMS device through the seat manager first, so the ICD's
+	// independent file cannot become DRM master ahead of logind.
+	const char *kmsFirst = getenv("ROWANOS_D16_KMS_FIRST");
+	const bool d16KmsFirst = !BIsNested() && kmsFirst && !strcmp(kmsFirst, "1");
+	if ( d16KmsFirst && !initOutput( g_nPreferredOutputWidth, g_nPreferredOutputHeight, g_nNestedRefresh ) )
+	{
+		fprintf( stderr, "Failed to initialize D16 output before Vulkan instance\n" );
+		return 1;
+	}
+
 	VkInstance instance = vulkan_create_instance();
+	if ( instance == VK_NULL_HANDLE )
+		return 1;
 	VkSurfaceKHR surface = VK_NULL_HANDLE;
 
 	if ( !BIsNested() )
@@ -765,7 +778,7 @@
 	}
 #endif
 
-	if ( !initOutput( g_nPreferredOutputWidth, g_nPreferredOutputHeight, g_nNestedRefresh ) )
+	if ( !d16KmsFirst && !initOutput( g_nPreferredOutputWidth, g_nPreferredOutputHeight, g_nNestedRefresh ) )
 	{
 		fprintf( stderr, "Failed to initialize output\n" );
 		return 1;
@@ -786,6 +799,20 @@
 	{
 		fprintf( stderr, "Failed to initialize Vulkan\n" );
 		return 1;
+	}
+
+	// Fail closed if Vulkan later identifies a primary different from the
+	// administrator's explicit early KMS selection.
+	if ( d16KmsFirst )
+	{
+		dev_t primaryId = 0;
+		struct stat outputStat = {};
+		if ( !vulkan_primary_dev_id( &primaryId ) || fstat( g_DRM.fd, &outputStat ) ||

+bool CVulkanDevice::createDummyResources()
+{
+    // Every descriptor gets a real image view of the shader's declared type.
+    // In particular the immutable YCbCr sampler needs a matching conversion.
+    const VkFormat formats[] = { VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_G8_B8R8_2PLANE_420_UNORM,
+                                 VK_FORMAT_R16G16B16A16_UNORM, VK_FORMAT_R16G16B16A16_UNORM };
+    const VkImageType types[] = { VK_IMAGE_TYPE_2D, VK_IMAGE_TYPE_2D, VK_IMAGE_TYPE_1D, VK_IMAGE_TYPE_3D };
+    const VkImageViewType views[] = { VK_IMAGE_VIEW_TYPE_2D, VK_IMAGE_VIEW_TYPE_2D, VK_IMAGE_VIEW_TYPE_1D, VK_IMAGE_VIEW_TYPE_3D };
+    auto command = commandBuffer();
+    if (!command) return false;
+    for (size_t i = 0; i < m_dummyImages.size(); ++i) {
+        VkImageCreateInfo image = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = types[i], .format = formats[i],
+            .extent = { 2, i == 2 ? 1u : 2u, i == 3 ? 2u : 1u },
+            .mipLevels = 1, .arrayLayers = 1, .samples = VK_SAMPLE_COUNT_1_BIT,
+            .tiling = VK_IMAGE_TILING_OPTIMAL,
+            .usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | (i == 0 ? VK_IMAGE_USAGE_STORAGE_BIT : 0u),
+            .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        };
+        VkResult result = vk.CreateImage(device(), &image, nullptr, &m_dummyImages[i]);
+        if (result != VK_SUCCESS) { vk_errorf(result, "dummy image creation failed"); return false; }
+        VkMemoryRequirements requirements;
+        vk.GetImageMemoryRequirements(device(), m_dummyImages[i], &requirements);
+        uint32_t memoryType = findMemoryType(VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, requirements.memoryTypeBits);
+        if (memoryType == ~0u) return false;
+        VkMemoryAllocateInfo memory = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+            .allocationSize = requirements.size, .memoryTypeIndex = memoryType };
+        result = vk.AllocateMemory(device(), &memory, nullptr, &m_dummyMemory[i]);
+        if (result != VK_SUCCESS) return false;
+        result = vk.BindImageMemory(device(), m_dummyImages[i], m_dummyMemory[i], 0);
+        if (result != VK_SUCCESS) return false;
+        VkSamplerYcbcrConversionInfo conversion = { .sType = VK_STRUCTURE_TYPE_SAMPLER_YCBCR_CONVERSION_INFO, .conversion = m_ycbcrConversion };
+        VkImageViewCreateInfo view = { .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+            .pNext = i == 1 ? &conversion : nullptr,
+            .image = m_dummyImages[i], .viewType = views[i], .format = formats[i],
+            .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 } };
+        result = vk.CreateImageView(device(), &view, nullptr, &m_dummyViews[i]);
+        if (result != VK_SUCCESS) return false;
+        VkImageMemoryBarrier barrier = { .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+            .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = m_dummyImages[i], .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 } };
+        vk.CmdPipelineBarrier(command->rawBuffer(), VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                              0, 0, nullptr, 0, nullptr, 1, &barrier);
+        if (i == 1) {
+            // Multi-planar images cannot be cleared with CmdClearColorImage.
+            memset(m_uploadBufferData, 0, 6);
+            VkBufferImageCopy regions[2] = {
+                { .bufferOffset = 0, .imageSubresource = {VK_IMAGE_ASPECT_PLANE_0_BIT, 0, 0, 1}, .imageExtent = {2, 2, 1} },
+                { .bufferOffset = 4, .imageSubresource = {VK_IMAGE_ASPECT_PLANE_1_BIT, 0, 0, 1}, .imageExtent = {1, 1, 1} },
+            };
+            vk.CmdCopyBufferToImage(command->rawBuffer(), m_uploadBuffer, m_dummyImages[i], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 2, regions);
+        } else {
+            VkClearColorValue zero = {};
+            vk.CmdClearColorImage(command->rawBuffer(), m_dummyImages[i], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &zero, 1, &barrier.subresourceRange);
+        }
+        barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+        barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | (i == 0 ? VK_ACCESS_SHADER_WRITE_BIT : 0u);
+        barrier.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+        barrier.newLayout = i < 2 ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+        vk.CmdPipelineBarrier(command->rawBuffer(), VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                              0, 0, nullptr, 0, nullptr, 1, &barrier);
+    }
+    submit(std::move(command));
+    waitIdle();
+    vk_log.infof("nullDescriptor unsupported: initialized real RGBA, YCbCr, 1D and 3D dummy descriptor images");
+    return true;
+}

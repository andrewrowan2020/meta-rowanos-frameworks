+class D16ScopedFd
+{
+public:
+    explicit D16ScopedFd(int fd = -1) : m_fd(fd) {}
+    ~D16ScopedFd() { if (m_fd >= 0) close(m_fd); }
+    D16ScopedFd(const D16ScopedFd &) = delete;
+    D16ScopedFd &operator=(const D16ScopedFd &) = delete;
+    int get() const { return m_fd; }
+    int release() { return std::exchange(m_fd, -1); }
+    void reset(int fd) { if (m_fd >= 0) close(m_fd); m_fd = fd; }
+private:
+    int m_fd;
+};
+
+// This is deliberately confined to the verified D16/Mali/mediatek mapping.
+// The heap supplies real external memory; Vulkan imports a separate owned FD.
+static bool allocateD16ScanoutMemory(VkImage image, const VkMemoryRequirements &requirements,
+                                    VkMemoryPropertyFlags preferredProperties,
+                                    VkDeviceMemory *memory, int *backingFd)
+{
+    if (!requirements.size || !g_device.vk.GetMemoryFdPropertiesKHR) return false;
+    D16ScopedFd heap(open("/dev/dma_heap/system", O_RDWR | O_CLOEXEC));
+    if (heap.get() < 0) {
+        vk_log.errorf_errno("D16 scanout: open system DMA heap failed");
+        return false;
+    }
+    dma_heap_allocation_data allocation = {};
+    allocation.len = requirements.size;
+    allocation.fd_flags = O_RDWR | O_CLOEXEC;
+    if (ioctl(heap.get(), DMA_HEAP_IOCTL_ALLOC, &allocation) < 0) {
+        vk_log.errorf_errno("D16 scanout: DMA heap allocation failed");
+        return false;
+    }
+    D16ScopedFd backing(int(allocation.fd));
+    const off_t fdSize = lseek(backing.get(), 0, SEEK_END);
+    if (fdSize < 0 || uint64_t(fdSize) < requirements.size) {
+        vk_log.errorf("D16 scanout: DMA heap buffer smaller than image requirements");
+        return false;
+    }
+    VkMemoryFdPropertiesKHR fdProperties = {};
+    fdProperties.sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR;
+    VkResult result = g_device.vk.GetMemoryFdPropertiesKHR(g_device.device(),
+        VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, backing.get(), &fdProperties);
+    if (result != VK_SUCCESS) {
+        vk_errorf(result, "D16 scanout: DMA heap memory properties failed");
+        return false;
+    }
+    const uint32_t compatible = requirements.memoryTypeBits & fdProperties.memoryTypeBits;
+    int32_t memoryType = g_device.findMemoryType(preferredProperties, compatible);
+    if (memoryType < 0) memoryType = g_device.findMemoryType(0, compatible);
+    if (memoryType < 0) {
+        vk_log.errorf("D16 scanout: no common DMA heap/image memory type");
+        return false;
+    }
+    D16ScopedFd imported(fcntl(backing.get(), F_DUPFD_CLOEXEC, 0));
+    if (imported.get() < 0) {
+        vk_log.errorf_errno("D16 scanout: duplicate DMA heap FD failed");
+        return false;
+    }
+    VkMemoryDedicatedAllocateInfo dedicated = {};
+    dedicated.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+    dedicated.image = image;
+    VkImportMemoryFdInfoKHR import = {};
+    import.sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR;
+    import.pNext = &dedicated;
+    import.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+    import.fd = imported.get();
+    VkMemoryAllocateInfo info = {};
+    info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+    info.pNext = &import;
+    info.allocationSize = uint64_t(fdSize);
+    info.memoryTypeIndex = uint32_t(memoryType);
+    result = g_device.vk.AllocateMemory(g_device.device(), &info, nullptr, memory);
+    if (result != VK_SUCCESS) {
+        vk_errorf(result, "D16 scanout: DMA heap Vulkan import failed");
+        return false;
+    }
+    imported.release(); // Only a successful Vulkan import consumes its FD.
+    *backingFd = backing.release();
+    return true;
+}
+
+// Only packed 32-bit SDR formats are enabled for this import route.
+static bool validD16LinearLayout(const VkSubresourceLayout &layout, uint32_t width,
+                                uint32_t height, VkDeviceSize allocationSize)
+{
+    const uint64_t rowBytes = uint64_t(width) * 4;
+    if (!width || !height || layout.offset > UINT32_MAX || layout.rowPitch > UINT32_MAX ||
+        layout.rowPitch < rowBytes || layout.offset > allocationSize ||
+        rowBytes > allocationSize - layout.offset ||
+        !layout.size || layout.size > allocationSize - layout.offset)
+        return false;
+    return uint64_t(height - 1) <= (allocationSize - layout.offset - rowBytes) / layout.rowPitch;
 }
 

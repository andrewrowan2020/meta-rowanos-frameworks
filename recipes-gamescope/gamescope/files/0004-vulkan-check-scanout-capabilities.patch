+static bool supportsLinearDmaBufExport( const VkImageCreateInfo &imageInfo )
+{
+    VkPhysicalDeviceExternalImageFormatInfo external = {};
+    external.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO;
+    external.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+    VkPhysicalDeviceImageFormatInfo2 query = {};
+    query.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2;
+    query.pNext = &external;
+    query.format = imageInfo.format;
+    query.type = imageInfo.imageType;
+    query.tiling = VK_IMAGE_TILING_LINEAR;
+    query.usage = imageInfo.usage;
+    query.flags = imageInfo.flags;
+    VkImageFormatListCreateInfo views = {};
+    if (const auto *list = pNextFind<VkImageFormatListCreateInfo>(&imageInfo, VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO)) {
+        views = *list;
+        views.pNext = std::exchange(query.pNext, &views);
+    }
+    VkExternalImageFormatProperties externalProps = {};
+    externalProps.sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES;
+    VkImageFormatProperties2 props = {};
+    props.sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2;
+    props.pNext = &externalProps;
+    VkResult result = g_device.vk.GetPhysicalDeviceImageFormatProperties2(g_device.physDev(), &query, &props);
+    return result == VK_SUCCESS &&
+        (externalProps.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT) &&
+        (externalProps.externalMemoryProperties.compatibleHandleTypes & VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT) &&
+        props.imageFormatProperties.maxExtent.width >= imageInfo.extent.width &&
+        props.imageFormatProperties.maxExtent.height >= imageInfo.extent.height &&
+        props.imageFormatProperties.maxExtent.depth >= imageInfo.extent.depth &&
+        props.imageFormatProperties.maxMipLevels >= imageInfo.mipLevels &&
+        props.imageFormatProperties.maxArrayLayers >= imageInfo.arrayLayers &&
+        (props.imageFormatProperties.sampleCounts & imageInfo.samples);
+}
